{
	"schemaVersion": 1,
	"id": "millenaire-new-age",
	"version": "${version}",
	"name": "Millenaire New Age",
	"description": "A living cultures mod. Villages with cultures, AI villagers, economy, quests and dynamic buildings.",
	"authors": [
		"mat37dev"
	],
	"contact": {
		"sources": "https://github.com/mat37dev/millenaire-new-age"
	},
	"license": "CC0-1.0",
	"icon": "assets/millenaire-new-age/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.mat37dev.MillenaireNewAge"
		],
		"client": [
			"com.mat37dev.MillenaireNewAgeClient"
		],
		"fabric-datagen": [
			"com.mat37dev.MillenaireNewAgeDataGenerator"
		],
		"cardinal-components": [
			"com.mat37dev.world.VillageComponents"
		]
	},
	"mixins": [
		"millenaire-new-age.mixins.json",
		{
			"config": "millenaire-new-age.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~1.21.10",
		"java": ">=21",
		"fabric-api": "*"
	},
	"custom": {
		"cardinal-components": [
			"millenaire-new-age:village_data"
		]
	}
}